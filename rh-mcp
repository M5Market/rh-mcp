# CLI subcommands.
# ==========================================================================

def cmd_serve(args):
    Proxy().run()


def cmd_login(args):
    run_login()
    if args.install:
        wire_all_clients()


def cmd_status(args):
    print(f"rh-mcp {__version__}  ({SELF_PATH})")
    print()
    print(f"Credentials: {CREDS_PATH}")
    if CREDS_PATH.exists():
        creds = load_creds()
        print(f"  expires: {fmt_exp(creds)}")
        print(f"  valid:   {is_token_valid(creds)}")
        print(f"  refresh: {bool(creds.get('refresh_token'))}")
    else:
        print("  (none — run 'rh-mcp login')")
    print()
    print("Client configs:")
    for client, path, keys in _client_targets():
        present = path.exists()
        rh = None
        if present:
            try:
                cfg = json.loads(path.read_text())
                node = cfg
                for k in keys:
                    node = node.get(k, {}) if isinstance(node, dict) else {}
                rh = node.get("robinhood") if isinstance(node, dict) else None
            except Exception:
                pass
        wired = bool(rh) and rh.get("command", "").endswith("rh-mcp")
        mark = "✓ wired (stdio)" if wired else ("✗ not wired" if present else "— client not found")
        print(f"  {client:14s} {mark}")
        if rh:
            safe = _redact_config(rh)
            print(f"                 {json.dumps(safe)}")


def _client_targets():
    return [
        ("zcode", ZCODE_CONFIG_PATH, ["mcp", "servers"]),
        ("claude", CLAUDE_CONFIG_PATH, ["mcpServers"]),
    ]


def wire_all_clients():
    print("\nWiring stdio proxy into MCP client configs...")
    for client, path, keys in _client_targets():
        ok, msg = wire_stdio_config(client, path, keys)
        print(f"  {client}: {msg}")


def cmd_self_test(args):
    """Run internal checks: PKCE vectors, SSE parsing, JSON handling."""
    loader = unittest.TestLoader()
    suite = loader.loadTestsFromModule(_build_test_module())
    runner = unittest.TextTestRunner(verbosity=2)
    result = runner.run(suite)
    sys.exit(0 if result.wasSuccessful() else 1)


def _build_test_module():
    """Build an in-memory test module (also imported by test_rh_mcp.py)."""
    import types
    mod = types.ModuleType("rh_mcp_selftest")

    class PKCEVectorTest(unittest.TestCase):
        # RFC 7636 Appendix B vector.
        def test_rfc7636_vector(self):
            verifier = ("dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk")
            expected = "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"
            self.assertEqual(pkce_challenge_for(verifier), expected)

        def test_gen_pkce_shape(self):
            v, c = gen_pkce()
            self.assertEqual(len(v), 43)
            self.assertEqual(len(c), 43)
            self.assertEqual(pkce_challenge_for(v), c)

    class SSEParseTest(unittest.TestCase):
        SAMPLE = (
            'event: message\n'
            'data: {"jsonrpc":"2.0","id":1,"result":{"capabilities":{}}}\n\n'
        )

        def test_single_event(self):
            results = list(parse_sse_stream(self.SAMPLE))
            self.assertEqual(len(results), 1)
            self.assertEqual(results[0]["id"], 1)

        def test_ignores_comments(self):
            body = ": comment\n" + self.SAMPLE
            self.assertEqual(len(list(parse_sse_stream(body))), 1)

        def test_empty_body(self):
            self.assertEqual(list(parse_sse_stream("")), [])

    mod.PKCEVectorTest = PKCEVectorTest
    mod.SSEParseTest = SSEParseTest
    return mod


