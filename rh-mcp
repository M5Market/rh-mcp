# ==========================================================================
# Logging — stderr only. stdout is reserved for the MCP protocol when serving.
# ==========================================================================

_log_lock = threading.Lock()


def log(msg: str):
    """Log to stderr (never stdout) and optionally to the log file."""
    line = f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}"
    with _log_lock:
        sys.stderr.write(line + "\n")
        sys.stderr.flush()
        try:
            LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
            with open(LOG_PATH, "a") as f:
                f.write(line + "\n")
        except OSError:
            pass  # logging is best-effort


def die(msg: str, code: int = 1):
    sys.stderr.write(f"ERROR: {msg}\n")
    sys.exit(code)


# ==========================================================================
# Utilities — base64url, PKCE, JSON HTTP.
# ==========================================================================

def b64url(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode("ascii")


def gen_pkce() -> tuple:
    """Return (verifier, challenge) per RFC 7636 S256."""
    verifier = b64url(secrets.token_bytes(32))
    challenge = b64url(hashlib.sha256(verifier.encode("ascii")).digest())
    return verifier, challenge


def pkce_challenge_for(verifier: str) -> str:
    """Compute the S256 challenge for a verifier (used by self-test vectors)."""
    return b64url(hashlib.sha256(verifier.encode("ascii")).digest())


def http_post_json(url, data, headers=None, timeout=DEFAULT_TIMEOUT_S):
    """POST JSON, return parsed JSON. Raise RuntimeError on non-2xx/parse error."""
    body = json.dumps(data).encode("utf-8")
    h = {"Content-Type": "application/json", "Accept": "application/json",
         "User-Agent": USER_AGENT}
    if headers:
        h.update(headers)
    req = urllib.request.Request(url, data=body, headers=h, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8")
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", "replace")
        raise RuntimeError(f"HTTP {e.code} from {url}: {raw}") from None
    except urllib.error.URLError as e:
        raise RuntimeError(f"network error to {url}: {e.reason}") from e
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        raise RuntimeError(f"non-JSON response from {url}: {raw!r}") from None


# ==========================================================================
# Token store — single source of truth, written atomically.
# ==========================================================================

class CredLock:
    """File lock around the credentials file to prevent concurrent clobbering."""

    def __init__(self, path: Path = LOCK_PATH):
        self.path = path
        self._fd = None

    def __enter__(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self._fd = open(self.path, "w")
        try:
            fcntl.flock(self._fd.fileno(), fcntl.LOCK_EX)
        except OSError:
            pass  # flock best-effort on all filesystems
        return self

    def __exit__(self, *exc):
        if self._fd:
            try:
                fcntl.flock(self._fd.fileno(), fcntl.LOCK_UN)
            except OSError:
                pass
            self._fd.close()


def save_creds(creds: dict):
    """Atomically persist credentials (chmod 0600)."""
    CREDS_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = CREDS_PATH.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(creds, indent=2))
    tmp.chmod(0o600)
    os.replace(tmp, CREDS_PATH)  # atomic on POSIX


def load_creds() -> dict:
    if not CREDS_PATH.exists():
        return {}
    try:
        return json.loads(CREDS_PATH.read_text())
    except json.JSONDecodeError:
        die(f"corrupt credentials file: {CREDS_PATH}. Remove it and run 'login'.")


def fmt_exp(creds: dict) -> str:
    exp = creds.get("access_token_expires_at")
    return "unknown" if not exp else time.strftime("%Y-%m-%d %H:%M:%S %Z", time.localtime(exp))


def is_token_valid(creds: dict) -> bool:
    exp = creds.get("access_token_expires_at")
    return bool(exp and time.time() < (exp - REFRESH_MARGIN_S))


def build_creds(token_resp: dict) -> dict:
    """Normalize a token-endpoint response into our stored shape."""
    if "access_token" not in token_resp:
        raise RuntimeError(f"token endpoint did not return access_token: {token_resp}")
    now = time.time()
    expires_in = token_resp.get("expires_in", 3600)
    return {
        "access_token": token_resp["access_token"],
        "refresh_token": token_resp.get("refresh_token"),
        "access_token_issued_at": int(now),
        "access_token_expires_at": int(now + expires_in),
        "expires_in": expires_in,
        "token_type": token_resp.get("token_type", "Bearer"),
        "scope": token_resp.get("scope", SCOPES),
    }


# ==========================================================================
# Auth — refresh (non-interactive) and login (browser PKCE).
# ==========================================================================

def refresh_token() -> dict:
    """Refresh using the stored refresh_token. Returns new creds or raises."""
    with CredLock():
        creds = load_creds()
        rt = creds.get("refresh_token")
        if not rt:
            raise RuntimeError("no refresh_token stored — run 'rh-mcp login'")
        log("refreshing access token")
        token_resp = http_post_json(TOKEN_ENDPOINT, {
            "grant_type": "refresh_token",
            "refresh_token": rt,
            "client_id": CLIENT_ID,
        })
        new_creds = build_creds(token_resp)
        # Robinhood may rotate the refresh_token; keep whichever is current.
        new_creds["refresh_token"] = token_resp.get("refresh_token", rt)
        save_creds(new_creds)
        log(f"refreshed; expires {fmt_exp(new_creds)}")
        return new_creds


def get_valid_token(allow_refresh: bool = True) -> str:
    """Return a live access_token, refreshing if necessary. Raises if no path."""
    creds = load_creds()
    if is_token_valid(creds):
        return creds["access_token"]
    if allow_refresh and creds.get("refresh_token"):
        creds = refresh_token()
        return creds["access_token"]
    raise AuthNeededError("no valid token and no refresh_token")


class AuthNeededError(Exception):
    """No valid token and no way to refresh non-interactively."""
    pass


# ---- login flow -----------------------------------------------------------

class _CBState:
    def __init__(self):
        self.code = None
        self.error = None
        self.received_state = None   # state echoed back by the redirect
        self.expected_state = None   # state we sent (CSRF check)
        self.received = threading.Event()


class _CallbackHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path != REDIRECT_PATH:
            self.send_response(404); self.end_headers(); return
        params = urllib.parse.parse_qs(parsed.query)
        self.server.cb_state.received_state = params.get("state", [None])[0]
        if "error" in params:
            self.server.cb_state.error = (
                params["error"][0], params.get("error_description", [""])[0])
        elif "code" in params:
            self.server.cb_state.code = params["code"][0]
        else:
            self.server.cb_state.error = ("invalid_request", "no code in callback")
        self.server.cb_state.received.set()
        self._respond()

    def _respond(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        if self.server.cb_state.code:
            html = ("<html><body style='font-family:sans-serif;padding:2em'>"
                    "<h2>Robinhood login successful</h2>"
                    "<p>You can close this tab and return to your terminal.</p>"
                    "</body></html>")
        else:
            err, desc = self.server.cb_state.error or ("unknown", "")
            html = ("<html><body style='font-family:sans-serif;padding:2em'>"
                    f"<h2>Login failed</h2><p><b>{err}</b></p><p>{desc}</p>"
                    "</body></html>")
        self.wfile.write(html.encode("utf-8"))

    def log_message(self, *a):
        pass


def run_login():
    """Interactive browser PKCE flow. Stores tokens on success."""
    with CredLock():
        verifier, challenge = gen_pkce()
        state = secrets.token_urlsafe(16)
        params = {
            "response_type": "code", "client_id": CLIENT_ID,
            "redirect_uri": REDIRECT_URI, "scope": SCOPES, "state": state,
            "code_challenge": challenge, "code_challenge_method": "S256",
        }
        auth_url = AUTH_ENDPOINT + "?" + urllib.parse.urlencode(params)

        cb_state = _CBState()
        cb_state.expected_state = state
        httpd = http.server.HTTPServer((REDIRECT_HOST, REDIRECT_PORT), _CallbackHandler)
        httpd.cb_state = cb_state
        httpd.timeout = 1
        thread = threading.Thread(target=httpd.serve_forever, daemon=True)
        thread.start()

        print("Opening browser for Robinhood login...")
        print(f"  {auth_url}")
        print(f"  Listening on {REDIRECT_URI}\n")
        try:
            webbrowser.open(auth_url)
        except Exception:
            pass

        deadline = time.time() + 300
        while not cb_state.received.is_set() and time.time() < deadline:
            time.sleep(0.5)
        httpd.shutdown(); thread.join(timeout=2)

        # CSRF validation — state must match what we sent.
        if cb_state.received_state != cb_state.expected_state:
            die("CSRF check failed: state mismatch. Aborting.")
        if cb_state.error:
            err, desc = cb_state.error
            die(f"login rejected by Robinhood: {err} ({desc})")
        if not cb_state.code:
            die("timed out waiting for browser callback (5 min). Re-run 'login'.")

        print("Authorization code received. Exchanging for tokens...")
        token_resp = http_post_json(TOKEN_ENDPOINT, {
            "grant_type": "authorization_code", "code": cb_state.code,
            "redirect_uri": REDIRECT_URI, "client_id": CLIENT_ID,
            "code_verifier": verifier,
        })
        creds = build_creds(token_resp)
        save_creds(creds)
        print(f"Tokens saved to {CREDS_PATH}")
        print(f"  expires: {fmt_exp(creds)}")
        print(f"  has refresh_token: {bool(creds.get('refresh_token'))}")


# ==========================================================================
# SSE parser — Robinhood wraps every response in text/event-stream framing.
# Each response is single-shot (no real streaming), terminated by connection
# close. We extract the `data:` JSON-RPC payload.
# ==========================================================================

def parse_sse_event(raw: str) -> dict:
    """Parse one SSE event block into {event, data}. Returns parsed JSON-RPC."""
    event_name = "message"
    data_lines = []
    for line in raw.split("\n"):
        if line.startswith(":") or line == "":
            continue
        if line.startswith("event:"):
            event_name = line[6:].strip()
        elif line.startswith("data:"):
            data_lines.append(line[5:].lstrip())
        elif line.startswith("data"):  # bare "data" with no colon
            data_lines.append(line[4:].lstrip())
    data = "\n".join(data_lines)
    if event_name != "message" or not data:
        return None
    try:
        return json.loads(data)
    except json.JSONDecodeError:
        log(f"could not parse SSE data as JSON: {data!r}")
        return None


def parse_sse_stream(body: str):
    """Yield parsed JSON-RPC envelopes from an SSE body (split on blank lines)."""
    # SSE events are separated by double newlines.
    for block in re.split(r"\n\s*\n", body):
        block = block.strip()
        if block:
            parsed = parse_sse_event(block)
            if parsed is not None:
                yield parsed


# ==========================================================================
# Upstream client — POST JSON-RPC to Robinhood, return parsed envelopes.
# ==========================================================================

class UpstreamError(Exception):
    def __init__(self, status, reason, body):
        self.status = status
        self.reason = reason
        self.body = body
        super().__init__(f"upstream {status} {reason}: {body[:200]}")


def call_upstream(envelope: dict, token: str, session_id: str = None,
                  timeout: int = DEFAULT_TIMEOUT_S):
    """Forward one JSON-RPC envelope to Robinhood. Returns list of response envelopes.

    Raises UpstreamError(status=401, ...) on auth failure so the caller can refresh+retry.
    """
    body = json.dumps(envelope).encode("utf-8")
    headers = {
        "Content-Type": "application/json",
        "Accept": "application/json, text/event-stream",
        "Authorization": f"Bearer {token}",
        "User-Agent": USER_AGENT,
    }
    if session_id:
        headers["Mcp-Session-Id"] = session_id

    req = urllib.request.Request(UPSTREAM_URL, data=body, headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            status = resp.status
            resp_body = resp.read().decode("utf-8", "replace")
            resp_session_id = resp.headers.get("Mcp-Session-Id")
            content_type = resp.headers.get("Content-Type", "")
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8", "replace")
        raise UpstreamError(e.code, e.reason, err_body) from None
    except urllib.error.URLError as e:
        raise UpstreamError(0, str(e.reason), "") from e

    if status == 401 or "jwt_invalid" in (resp_body + str(headers)):
        raise UpstreamError(401, "Unauthorized", resp_body)

    # Parse the response body. SSE-framed if content-type says so, else plain JSON.
    envelopes = []
    if "text/event-stream" in content_type:
        for env in parse_sse_stream(resp_body):
            envelopes.append(env)
    else:
        try:
            envelopes.append(json.loads(resp_body))
        except json.JSONDecodeError:
            if resp_body.strip():
                log(f"unparseable non-SSE response: {resp_body[:300]!r}")
    return envelopes, resp_session_id


# ==========================================================================
# Proxy — the stdio read/forward loop. This is the core of `serve`.
# ==========================================================================

class Proxy:
    def __init__(self):
        self.session_id = None
        self.token = None
        self._init_done = False

    def run(self):
        log("rh-mcp proxy starting")
        try:
            self.token = get_valid_token(allow_refresh=True)
            log(f"proxy ready; token expires {fmt_exp(load_creds())}")
        except (AuthNeededError, RuntimeError) as e:
            log(f"startup auth failed: {e}")
            if sys.stderr.isatty():
                sys.stderr.write(
                    f"\nNo valid Robinhood token. Run: {SELF_PATH} login\n\n")
            sys.exit(1)

        # Each line on stdin is one JSON-RPC envelope (NDJSON).
        for raw_line in sys.stdin:
            line = raw_line.strip()
            if not line:
                continue
            try:
                envelope = json.loads(line)
            except json.JSONDecodeError:
                log(f"ignoring non-JSON stdin line: {line[:120]!r}")
                continue
            try:
                self._handle(envelope)
            except Exception as e:
                log(f"error handling request: {e}")
                self._maybe_error(envelope, -32603, f"internal proxy error: {e}")

    def _handle(self, envelope: dict):
        method = envelope.get("method", "")
        req_id = envelope.get("id")  # None for notifications
        is_notification = req_id is None

        # Forward everything upstream (including notifications).
        envelopes, new_session = self._forward(envelope)
        if new_session:
            self.session_id = new_session

        # Notifications (no id) get no response on stdout — correct MCP behavior.
        if is_notification:
            return

        # Emit each response envelope back to the client as NDJSON.
        for env in envelopes:
            self._write(env)

        # If upstream returned nothing for a request, synthesize an error.
        if req_id is not None and not envelopes:
            self._maybe_error(envelope, -32603, "upstream returned no response")

    def _forward(self, envelope: dict, _retried=False):
        """Forward to Robinhood, handling 401 with one refresh+retry."""
        try:
            return call_upstream(envelope, self.token, self.session_id)
        except UpstreamError as e:
            if e.status == 401 and not _retried:
                log(f"401 from upstream ({e.body[:80]}); refreshing and retrying")
                try:
                    creds = refresh_token()
                    self.token = creds["access_token"]
                    return self._forward(envelope, _retried=True)
                except Exception as re:
                    log(f"refresh failed: {re}")
                    # Surface auth error to client as a JSON-RPC error.
                    req_id = envelope.get("id")
                    if req_id is not None:
                        self._write({
                            "jsonrpc": "2.0", "id": req_id,
                            "error": {"code": -32001,
                                      "message": "Robinhood auth failed — run 'rh-mcp login'",
                                      "data": {"refresh_error": str(re)}}})
                    return [], self.session_id
            if e.status == 0:
                raise  # network error — let caller handle
            # Other HTTP errors: log and return empty (caller synthesizes error).
            log(f"upstream error {e.status}: {e.body[:200]}")
            return [], self.session_id

    def _write(self, envelope: dict):
        sys.stdout.write(json.dumps(envelope, separators=(",", ":")) + "\n")
        sys.stdout.flush()

    def _maybe_error(self, req_envelope: dict, code: int, message: str):
        req_id = req_envelope.get("id")
        if req_id is not None:
            self._write({"jsonrpc": "2.0", "id": req_id,
                         "error": {"code": code, "message": message}})


# ==========================================================================
# Config wiring — atomic writes, multi-client detection.
# ==========================================================================

def _redact_config(node):
    """Return a copy of a config dict with any bearer tokens redacted (for display).

    Keeps only the auth scheme prefix (e.g. "Bearer ") and redacts the rest,
    so nothing sensitive leaks into status output or logs.
    """
    if isinstance(node, dict):
        out = {}
        for k, v in node.items():
            if k.lower() == "authorization" and isinstance(v, str):
                parts = v.split(" ", 1)
                scheme = parts[0] if len(parts) == 2 and parts[0].lower() in (
                    "bearer", "basic", "token") else ""
                out[k] = (scheme + " <redacted>") if scheme else "<redacted>"
            else:
                out[k] = _redact_config(v)
        return out
    if isinstance(node, list):
        return [_redact_config(x) for x in node]
    return node


def _atomic_write_json(path: Path, data: dict):
    """Write JSON atomically: temp → fsync → rename. Keep a .bak."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    bak = path.with_suffix(path.suffix + ".bak")
    if path.exists():
        try:
            import shutil
            shutil.copy2(path, bak)
        except OSError:
            pass
    tmp.write_text(json.dumps(data, indent=2))
    os.replace(tmp, path)


def wire_stdio_config(client: str, config_path: Path, server_key_path: list):
    """Wire the stdio proxy into a client's config (idempotent)."""
    if not config_path.exists():
        return False, f"{config_path} not found"
    try:
        cfg = json.loads(config_path.read_text())
    except json.JSONDecodeError:
        return False, f"{config_path} is not valid JSON"

    # Navigate/create the nested structure (e.g. mcp.servers or mcpServers).
    node = cfg
    for key in server_key_path[:-1]:
        node = node.setdefault(key, {})
    servers = node.setdefault(server_key_path[-1], {})

    servers["robinhood"] = {
        "type": "stdio",
        "command": str(SELF_PATH),
        "args": ["serve"],
    }
    _atomic_write_json(config_path, cfg)
    return True, f"wired robinhood stdio proxy into {config_path}"


