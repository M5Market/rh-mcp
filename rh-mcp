def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="rh-mcp",
        description="Robinhood MCP proxy with integrated OAuth",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Run 'rh-mcp login' once, then point your MCP client at this "
               "script with 'serve'. See README for client config snippets.")
    sub = parser.add_subparsers(dest="cmd")

    p_serve = sub.add_parser("serve", help="run the stdio proxy (default)")
    p_serve.set_defaults(func=cmd_serve)

    p_login = sub.add_parser("login", help="browser OAuth flow")
    p_login.add_argument("--install", action="store_true",
                         help="also wire stdio proxy into detected client configs")
    p_login.set_defaults(func=cmd_login)

    p_status = sub.add_parser("status", help="show token + wiring status")
    p_status.set_defaults(func=cmd_status)

    p_test = sub.add_parser("self-test", help="run internal checks")
    p_test.set_defaults(func=cmd_self_test)

    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        # Default to serve (so MCP clients can invoke with no subcommand).
        Proxy().run()
        return
    args.func(args)


if __name__ == "__main__":
    main()
